{
  "name": "astra-orbital-collision-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run --root apps/web",
    "format:check": "prettier --check apps/web packages/contracts data/fixtures",
    "lint": "oxlint apps/web/src",
    "contracts:generate": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/api.d.ts",
    "contracts:check": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/api.d.ts --check",
    "predev": "node scripts/stage_cesium.mjs",
    "prebuild": "node scripts/stage_cesium.mjs"
  },
  "dependencies": {
    "cesium": "^1.147.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "openapi-typescript": "^7.0.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
